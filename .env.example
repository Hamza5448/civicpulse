# Application
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL 16
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://civicpulse:replace-with-a-local-password@localhost:5432/civicpulse

# Redis 7
REDIS_URL=redis://localhost:6379/0

# AI provider selection; supported providers will be added in later phases.
AI_PROVIDER=rule_based
LLM_API_KEY=replace-with-a-provider-key-when-needed
OLLAMA_BASE_URL=http://localhost:11434

# Phase 3 triage provider selection: rules, simulated, llm, or ollama
TRIAGE_PROVIDER=rules
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_LLM_BASE_URL=https://api.groq.com/openai/v1
TRIAGE_LLM_MODEL=llama-3.1-8b-instant
TRIAGE_LLM_API_KEY=replace-with-a-provider-key-when-needed
TRIAGE_OLLAMA_BASE_URL=http://localhost:11434
TRIAGE_OLLAMA_MODEL=llama3.2:1b

# Frontend
VITE_API_BASE_URL=http://localhost:8000
